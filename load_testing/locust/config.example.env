# Base target
LOCUST_HOST=http://localhost:8000

# Locust runtime
LOCUST_USERS=50
LOCUST_SPAWN_RATE=5
LOCUST_RUN_TIME=5m
LOCUST_STOP_TIMEOUT=30

# Profile selection
LOCUST_PROFILE=steady_state_cache_hit

# Endpoint weights
W_HEALTH=1
W_METRICS=10
W_SCHEMA=1
W_STREAMS=3
W_TOP=3
W_HIST=3

# Optional request headers (semicolon-separated key=value pairs)
# Example: LOCUST_HEADERS=Authorization=Bearer local-token;X-Trace-Id=abc123
LOCUST_HEADERS=

# Burst/refresh tuning
BURST_SIZE=8
REFRESH_CYCLE_REQUESTS=8
REFRESH_TEST_MODE=0
REFRESH_TTL_SECONDS=0.25
